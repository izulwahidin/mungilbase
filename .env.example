# Exported into the process environment; copy to .env and load it however you deploy.
MUNGIL_CONFIG=./mungil.config.ts
MUNGIL_DB_FILE=./data/mungil.db
MUNGIL_VERSION=0.5.0

# Set to 1 only when a trusted reverse proxy sets X-Forwarded-For.
# Otherwise clients can spoof their own rate-limit bucket.
MUNGIL_TRUST_PROXY=

# If set, GET /metrics requires "Authorization: Bearer <token>".
MUNGIL_METRICS_TOKEN=

# Optional Sentry-compatible DSN for unhandled errors (and uncaught exceptions).
MUNGIL_SENTRY_DSN=

# OAuth client secrets (see auth.oauth in the config for client ids).
MUNGIL_GOOGLE_CLIENT_SECRET=
MUNGIL_GITHUB_CLIENT_SECRET=

# S3-compatible object storage (storage.provider = "s3").
MUNGIL_S3_ACCESS_KEY_ID=
MUNGIL_S3_SECRET_ACCESS_KEY=

# Used once by `mungilbase user create` / `user passwd`; never needed by the server.
MUNGIL_USER_PASSWORD=
MUNGIL_USER_ROLE=user

# SMTP password for the email provider (default variable name; see email.smtp.passwordEnv).
MUNGIL_SMTP_PASSWORD=
