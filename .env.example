# Used by docker compose (and by the app when the variables are exported).
MUNGIL_CONFIG=./mungil.config.ts
MUNGIL_DB_FILE=./data/mungil.db
MUNGIL_VERSION=0.1.0

# Set to 1 only when a trusted reverse proxy sets X-Forwarded-For.
# Otherwise clients can spoof their own rate-limit bucket.
MUNGIL_TRUST_PROXY=

# If set, GET /metrics requires "Authorization: Bearer <token>".
MUNGIL_METRICS_TOKEN=

# Used once by `npm run user:create`; never needed by the server.
MUNGIL_USER_PASSWORD=

# Optional: Litestream sidecar (profile "backup" in docker-compose.yml).
LITESTREAM_BUCKET=
LITESTREAM_REGION=
LITESTREAM_ENDPOINT=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
