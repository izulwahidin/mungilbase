{
  "name": "mungilbase",
  "version": "0.1.0",
  "description": "A small, self-hosted backend defined by a typed config file: REST, auth, row-level rules, migrations.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/cli/migrate.ts",
    "user:create": "tsx src/cli/create-user.ts",
    "user:passwd": "tsx src/cli/reset-password.ts",
    "backup": "tsx src/cli/backup.ts",
    "drill": "bash scripts/restore-drill.sh",
    "bench": "tsx scripts/bench.ts",
    "check": "npm run typecheck && npm run test && npm run build",
    "ci": "bash scripts/ci.sh"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3": "^11.8.1",
    "hono": "^4.6.16",
    "jsep": "^1.4.0",
    "nodemailer": "^10.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "fast-check": "^3.23.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
